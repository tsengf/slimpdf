# Native installation packages. Enable with -DSLIMPDF_BUILD_PACKAGES=ON.
if(APPLE OR WIN32)
    if(Qt6_VERSION VERSION_LESS 6.5)
        message(FATAL_ERROR "Bundled installation packages require Qt 6.5 or newer")
    endif()
    qt_generate_deploy_app_script(TARGET slimpdf OUTPUT_SCRIPT deploy_script)
    install(SCRIPT "${deploy_script}")
endif()

set(CPACK_PACKAGE_NAME "SlimPDF")
set(CPACK_PACKAGE_VENDOR "SlimPDF contributors")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A lightweight PDF reader with automatic reloads")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/tsengf/slimpdf")
set(CPACK_PACKAGE_CONTACT "https://github.com/tsengf/slimpdf/issues")
set(CPACK_RESOURCE_FILE_README "${PROJECT_SOURCE_DIR}/README.md")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "SlimPDF")
set(CPACK_VERBATIM_VARIABLES YES)

set(package_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES arch_count)
    if(arch_count GREATER 1)
        set(package_arch universal)
    else()
        set(package_arch "${CMAKE_OSX_ARCHITECTURES}")
    endif()
elseif(WIN32)
    # CMAKE_SYSTEM_PROCESSOR can describe the host rather than the MSVC target.
    if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]64")
        set(package_arch arm64)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(package_arch x86_64)
    else()
        set(package_arch x86)
    endif()
endif()
set(CPACK_PACKAGE_FILE_NAME "SlimPDF-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${package_arch}")

if(APPLE)
    set(CPACK_GENERATOR DragNDrop)
    set(CPACK_DMG_VOLUME_NAME "SlimPDF ${PROJECT_VERSION}")
    set(CPACK_DMG_FORMAT UDZO)
    set(CPACK_DMG_SLA_USE_RESOURCE_FILE_LICENSE OFF)
elseif(WIN32)
    set(CPACK_GENERATOR NSIS)
    set(CPACK_NSIS_DISPLAY_NAME "SlimPDF")
    set(CPACK_NSIS_PACKAGE_NAME "SlimPDF")
    set(CPACK_NSIS_URL_INFO_ABOUT "${CPACK_PACKAGE_HOMEPAGE_URL}")
    set(CPACK_NSIS_HELP_LINK "${CPACK_PACKAGE_CONTACT}")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_MODIFY_PATH OFF)
    set(CPACK_PACKAGE_EXECUTABLES "slimpdf;SlimPDF")
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY "${CMAKE_INSTALL_BINDIR}")
    set(CPACK_NSIS_MUI_FINISHPAGE_RUN "${CMAKE_INSTALL_BINDIR}/slimpdf.exe")
else()
    set(CPACK_GENERATOR "DEB;RPM")
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    set(CPACK_DEBIAN_PACKAGE_NAME slimpdf)
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "SlimPDF contributors")
    set(CPACK_DEBIAN_PACKAGE_SECTION graphics)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    # Platform plugins are loaded at runtime, so shlibdeps cannot infer them.
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-qpa-plugins")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_RPM_PACKAGE_NAME slimpdf)
    set(CPACK_RPM_PACKAGE_LICENSE MIT)
    set(CPACK_RPM_PACKAGE_GROUP "Applications/Publishing")
    set(CPACK_RPM_PACKAGE_URL "${CPACK_PACKAGE_HOMEPAGE_URL}")
    set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
        /usr/share/applications /usr/share/doc /usr/share/licenses)
endif()

include(CPack)
